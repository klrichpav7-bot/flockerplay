generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ROLE_USER
  ROLE_ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  HIDDEN
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  COMPLETED
  CANCELLED
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ComplaintStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum TxType {
  RECHARGE
  PURCHASE
  SALE
  ADMIN
  WITHDRAWAL
  PROMO
}

enum PromoType {
  BALANCE
  DISCOUNT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BannerStatus {
  PENDING
  ACTIVE
  HIDDEN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  googleId     String?  @unique
  needsSetup   Boolean  @default(false)
  role         Role     @default(ROLE_USER)
  avatarUrl    String?
  about        String? @db.Text
  isSeller     Boolean  @default(false)
  isVerified   Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  balance      Int      @default(0)
  heldBalance  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products        Product[]
  orders          Order[]          @relation("buyerOrders")
  soldOrders      Order[]          @relation("sellerOrders")
  orderMessages   OrderMessage[]
  balanceTx       BalanceTransaction[]
  topUps          TopUpRequest[]
  tickets         Ticket[]
  messages        Message[]
  notifications   Notification[]
  complaintsMade  Complaint[]      @relation("complaintsMade")
  complaintsOnMe  Complaint[]      @relation("complaintsOnMe")
  banners         Banner[]
  payments        Payment[]
  withdrawals     Withdrawal[]
  reviewsMade     Review[]         @relation("reviewsMade")
  reviewsReceived Review[]         @relation("reviewsReceived")
  promoRedemptions PromoRedemption[]
  pendingPromoDiscount PromoCode?  @relation("pendingDiscount", fields: [promoDiscountId], references: [id], onDelete: SetNull)
  promoDiscountId String?          @unique

  @@index([role])
  @@index([isSeller])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  accent    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  featured  Boolean  @default(false)

  products     Product[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  slug       String
  icon       String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Product {
  id           String        @id @default(cuid())
  sellerId     String
  categoryId   String
  subcategoryId String?
  title        String
  description  String @db.Text
  price        Int
  oldPrice     Int?
  stock        Int           @default(0)
  images       Json?
  deliveryType String        @default("AUTO")
  deliveryInfo String @db.Text
  status       ProductStatus @default(PENDING)
  isFeatured   Boolean       @default(false)
  isOfficial   Boolean       @default(false)
  soldCount    Int           @default(0)
  rating       Float         @default(5)
  ratingCount  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  orderItems  Order[]
  reviews     Review[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
}

model Order {
  id              String      @id @default(cuid())
  buyerId         String
  sellerId        String
  productId       String?
  total           Int
  qty             Int         @default(1)
  sellerAmount    Int         @default(0)
  status          OrderStatus @default(PENDING)
  buyerNote       String? @db.Text
  deliveryInfo    String? @db.Text
  deliveredAt     DateTime?
  fundsFrozenAt   DateTime?
  fundsReleaseAt  DateTime?
  fundsReleasedAt DateTime?
  buyerLastReadAt DateTime?
  sellerLastReadAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyer   User     @relation("buyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User     @relation("sellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  review  Review?
  messages OrderMessage[]
  tickets  Ticket[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([fundsReleaseAt])
}

model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model BalanceTransaction {
  id        String   @id @default(cuid())
  userId    String
  type      TxType
  amount    Int
  reason    String? @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  provider   String   @default("yoomoney")
  providerId String?  @unique
  amount     Int
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  amount     Int
  method     String
  details    String @db.Text
  status     WithdrawalStatus @default(PENDING)
  adminNote  String? @db.Text
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  productId String
  buyerId   String
  sellerId  String
  rating    Int
  comment   String? @db.Text
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation("reviewsMade", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("reviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
}

model TopUpRequest {
  id         String      @id @default(cuid())
  userId     String
  amount     Int
  method     String?
  comment    String? @db.Text
  proofUrl   String? @db.Text
  status     TopUpStatus @default(PENDING)
  adminNote  String? @db.Text
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  orderId   String?
  subject   String @db.Text
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  body      String @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Complaint {
  id         String          @id @default(cuid())
  reporterId String
  targetId   String
  orderId    String?
  reason     String
  text       String? @db.Text
  status     ComplaintStatus @default(PENDING)
  adminNote  String? @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  reporter User @relation("complaintsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("complaintsOnMe", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String? @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Banner {
  id         String       @id @default(cuid())
  ownerId    String
  title      String
  imageUrl   String? @db.Text
  linkUrl    String? @db.Text
  placement  String       @default("HOME")
  status     BannerStatus @default(PENDING)
  sortOrder  Int          @default(0)
  durationMs Int          @default(5000)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime     @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([placement])
}

model PromoCode {
  id        String      @id @default(cuid())
  code      String      @unique
  type      PromoType   @default(BALANCE)
  value     Int
  maxUses   Int         @default(0)
  uses      Int         @default(0)
  startsAt  DateTime?
  expiresAt DateTime?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  redemptions   PromoRedemption[]
  pendingUsers  User[]            @relation("pendingDiscount")

  @@index([type])
  @@index([active])
  @@index([expiresAt])
}

model PromoRedemption {
  id        String   @id @default(cuid())
  promoId   String
  userId    String
  createdAt DateTime @default(now())

  promo PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoId, userId])
  @@index([userId])
}

model SiteSetting {
  id           String   @id @default("main")
  siteName     String   @default("FlockerPlay")
  tagline      String   @default("Игровой маркетплейс цифровых товаров и услуг")
  supportEmail String   @default("Flocker@gmail.com")
  telegram     String   @default("")
  vk           String   @default("")
  discord      String   @default("")
  commission   Int      @default(0)
  minTopUp     Int      @default(50)
  minWithdrawal Int     @default(100)
  starsRate    Int      @default(150)
  starsMin     Int      @default(100)
  starsMax     Int      @default(100000)
  updatedAt    DateTime @updatedAt
}
